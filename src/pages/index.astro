---
import Base from '../layouts/Base.astro';
import tokens from '../../tokens/grid.json';

const grid = tokens.grid;
const rows = [
  ['Columns', `${grid.columns.mobile.value} below 768px, ${grid.columns.tablet.value} from 768px, ${grid.columns.desktop.value} from 1024px`],
  ['Gutter', `${grid.gutter.mobile.value} below 768px, ${grid.gutter.desktop.value} from 768px`],
  ['Margin', `${grid.margin.mobile.value} below 768px, ${grid.margin.desktop.value} from 768px`],
  ['Max width', grid.maxWidth.value],
  ['Breakpoints', `${grid.breakpoint.tablet.value} tablet, ${grid.breakpoint.desktop.value} desktop`],
  ['Diagonal', `${grid.tilt.value} tilt on key elements`],
];
---
<Base title="Bernardo Reyes — Identity Guidelines">
  <main class="grid">
    <section class="section">
      <h1 class="display">Bernardo Reyes</h1>
      <p class="lead">Identity guidelines are in progress. This section shows the layout grid.</p>
    </section>

    <section class="section" aria-labelledby="grid-title">
      <h2 id="grid-title" class="h2">Grid</h2>
      <p>
        One grid for every layout. Columns, gutters, and margins come from the tokens, so the same
        rules apply to the page, the PDF, and the applied examples.
      </p>

      <div class="grid-demo">
        <div class="grid-track">
          <div class="block block-wide">Wide block</div>
          <div class="block block-narrow">Narrow</div>
          <div class="block block-narrow">Narrow</div>
        </div>
        <div class="grid-overlay" data-grid-overlay hidden></div>
      </div>

      <p>
        <button type="button" class="toggle" data-grid-toggle aria-pressed="false">Show grid</button>
      </p>

      <table class="spec">
        <tbody>
          {rows.map(([label, value]) => (
            <tr>
              <th scope="row">{label}</th>
              <td>{value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="section" aria-labelledby="tilt-title">
      <h2 id="tilt-title" class="h2">Diagonal</h2>
      <p>The diagonal is the one rule that breaks the grid on purpose. Use it for dividers and key elements only.</p>
      <div class="tilt-rule" aria-hidden="true"></div>
    </section>
  </main>
</Base>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-grid-toggle]');
  const overlay = document.querySelector<HTMLElement>('[data-grid-overlay]');

  toggle?.addEventListener('click', () => {
    if (!overlay) return;
    const showing = overlay.hidden;
    overlay.hidden = !showing;
    toggle.setAttribute('aria-pressed', String(showing));
    toggle.textContent = showing ? 'Hide grid' : 'Show grid';
  });
</script>

<style>
  .section {
    padding-block: var(--space-7);
  }

  .display {
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-regular);
    font-size: var(--font-size-display);
    line-height: var(--line-height-tight);
    color: var(--color-red-constructivist);
    text-transform: uppercase;
    margin: 0 0 var(--space-5);
  }

  .lead {
    font-size: var(--font-size-lead);
    max-width: 40ch;
  }

  .h2 {
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-regular);
    font-size: var(--font-size-h2);
    line-height: var(--line-height-heading);
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
  }

  .grid-demo {
    position: relative;
    margin-block: var(--space-5);
  }

  .block {
    background: var(--color-ink-black);
    color: var(--color-paper-cream);
    padding: var(--space-4);
    font-family: var(--font-family-caption);
    font-size: var(--font-size-caption);
    text-transform: uppercase;
    min-height: 6rem;
  }

  .block-wide {
    grid-column: span 2;
  }

  .block-narrow {
    grid-column: span 1;
  }

  .toggle {
    font-family: var(--font-family-caption);
    font-size: var(--font-size-caption);
    text-transform: uppercase;
    background: var(--color-ink-black);
    color: var(--color-paper-cream);
    border: 0;
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
  }

  .spec {
    border-collapse: collapse;
    width: 100%;
    font-family: var(--font-family-caption);
    font-size: var(--font-size-caption);
    margin-top: var(--space-5);
  }

  .spec th,
  .spec td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid var(--color-ink-black);
    vertical-align: top;
  }

  .spec th {
    width: 30%;
    font-weight: var(--font-weight-medium);
  }
</style>
