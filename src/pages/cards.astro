---
import Base from '../layouts/Base.astro';
import logoCream from '../../logo/bernie-cream.svg?url';
import logoMono from '../../logo/bernie-mono.svg?url';
import logoCrane from '../../logo/bernie-crane.svg?url';

// Placeholder contact details. Replace these with your real ones before printing.
const contact = {
  name: 'Bernardo Reyes',
  mail: 'your.email@example.com',
  linkedin: 'linkedin.com/in/your-handle',
  phone: '+00 000 000 0000',
};
const callMe = 'You can call me';
const role = 'Service Designer · UX Designer';
---
<Base title="Bernardo Reyes — Business cards">
  <main class="cards-page">
    <header class="cards-intro">
      <h1 class="h1">Business cards</h1>
      <p class="body">Front: name and contact details. Back: "You can call me," the BERNIE logo, and the role below. Size: 3.5 × 2 in. Contact details are placeholders.</p>
    </header>

    <section class="variant" aria-labelledby="a-title">
      <h2 id="a-title" class="caption">Layout A · Stacked</h2>
      <div class="card card-a-front">
        <div class="a-name">
          <p class="card-name">{contact.name}</p>
          <ul class="contact">
            <li>{contact.mail}</li>
            <li>{contact.linkedin}</li>
            <li>{contact.phone}</li>
          </ul>
        </div>
        <img class="crane-edge" src={logoCrane} alt="" aria-hidden="true" />
      </div>
      <div class="card card-a-back">
        <img class="back-logo" src={logoCream} alt="BERNIE" />
        <p class="tagline">{callMe}</p>
        <p class="role">{role}</p>
      </div>
    </section>

    <section class="variant" aria-labelledby="b-title">
      <h2 id="b-title" class="caption">Layout B · Tilted band</h2>
      <div class="card card-b-front">
        <div class="band"><p class="card-name">{contact.name}</p></div>
        <ul class="contact contact-b">
          <li>{contact.mail}</li>
          <li>{contact.linkedin}</li>
          <li>{contact.phone}</li>
        </ul>
      </div>
      <div class="card card-b-back">
        <img class="back-logo" src={logoCream} alt="BERNIE" />
        <p class="tagline">{callMe}</p>
        <p class="role">{role}</p>
      </div>
    </section>

    <section class="variant" aria-labelledby="c-title">
      <h2 id="c-title" class="caption">Layout C · Red front</h2>
      <div class="card card-c-front">
        <p class="card-name card-name-c">{contact.name}</p>
        <ul class="contact contact-c">
          <li>{contact.mail}</li>
          <li>{contact.linkedin}</li>
          <li>{contact.phone}</li>
        </ul>
      </div>
      <div class="card card-c-back">
        <img class="back-logo" src={logoMono} alt="BERNIE" />
        <p class="tagline">{callMe}</p>
        <p class="role">{role}</p>
      </div>
    </section>
  </main>
</Base>

<style>
  /* Card size: 3.5 in by 2 in. Every card is one printed page. */
  .cards-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-7);
  }

  .h1 {
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-regular);
    font-size: var(--font-size-h2);
    text-transform: uppercase;
    color: var(--color-red-constructivist);
    margin: 0 0 var(--space-3);
  }

  .body {
    max-width: 62ch;
  }

  .caption {
    font-family: var(--font-family-caption);
    font-size: var(--font-size-caption);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: var(--space-6) 0 var(--space-3);
  }

  .variant {
    display: grid;
    gap: var(--space-4);
  }

  .card {
    position: relative;
    width: 3.5in;
    height: 2in;
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
    padding: 0.2in;
    font-family: var(--font-family-caption);
    box-shadow: 0 0 0 1px var(--color-ink-black);
  }

  .card-name {
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-regular);
    text-transform: uppercase;
    margin: 0;
    line-height: var(--line-height-tight);
  }

  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 7.5pt;
    line-height: 1.5;
  }

  .back-logo {
    position: absolute;
    left: 0.2in;
    top: 0.2in;
    width: 1.3in;
    height: auto;
  }

  .tagline {
    position: absolute;
    left: 0.2in;
    right: 0.2in;
    top: 0.75in;
    font-family: var(--font-family-display);
    font-size: 24pt;
    text-transform: uppercase;
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .role {
    position: absolute;
    left: 0.2in;
    bottom: 0.2in;
    font-family: var(--font-family-caption);
    font-size: 7.5pt;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* Layout A */
  .card-a-front {
    background: var(--color-ink-black);
    color: var(--color-paper-cream);
  }

  .a-name {
    position: absolute;
    left: 0.2in;
    bottom: 0.3in;
  }

  .a-name .card-name {
    font-size: 19pt;
    color: var(--color-paper-cream);
  }

  .crane-edge {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 1.1in;
    height: auto;
  }

  .card-a-back {
    background: var(--color-red-constructivist);
    color: var(--color-paper-cream);
  }

  /* Layout B */
  .card-b-front {
    background: var(--color-paper-cream);
    color: var(--color-ink-black);
  }

  .band {
    position: absolute;
    left: -0.3in;
    right: -0.3in;
    top: 0.6in;
    height: 0.6in;
    background: var(--color-red-constructivist);
    transform: rotate(calc(-1 * var(--grid-tilt)));
    display: flex;
    align-items: center;
    padding-left: 0.5in;
  }

  .band .card-name {
    font-size: 19pt;
    color: var(--color-paper-cream);
  }

  .contact-b {
    position: absolute;
    right: 0.2in;
    bottom: 0.2in;
    text-align: right;
    color: var(--color-ink-black);
  }

  .card-b-back {
    background: var(--color-ink-black);
    color: var(--color-paper-cream);
  }

  /* Layout C */
  .card-c-front {
    background: var(--color-red-constructivist);
    color: var(--color-paper-cream);
  }

  .card-name-c {
    position: absolute;
    left: 0.2in;
    bottom: 0.95in;
    font-size: 22pt;
    color: var(--color-paper-cream);
  }

  .contact-c {
    position: absolute;
    left: 0.2in;
    bottom: 0.2in;
    color: var(--color-paper-cream);
  }

  .card-c-back {
    background: var(--color-paper-cream);
    color: var(--color-ink-black);
  }

  .card-c-back .tagline {
    color: var(--color-red-constructivist);
  }

  /* Print: one card per page at true size. */
  @media print {
    @page {
      size: 3.5in 2in;
      margin: 0;
    }

    .cards-intro,
    .caption {
      display: none;
    }

    .cards-page {
      padding: 0;
      max-width: none;
    }

    .variant {
      display: block;
    }

    .card {
      box-shadow: none;
      break-after: page;
      max-width: none;
    }

    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
